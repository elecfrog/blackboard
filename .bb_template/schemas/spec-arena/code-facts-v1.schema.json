{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bb://schema/spec-arena/code-facts-v1",
  "title": "Spec Arena Code Facts",
  "description": "Deterministic read-only repository facts consumed by Spec Arena reviewers. Issue-agnostic: the script reports presence/size for caller-supplied target files plus a short head-of-file slice of the draft.",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "repo_root",
    "files",
    "draft_checks"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "spec_arena_code_facts" },
    "repo_root": { "type": "string", "minLength": 1 },
    "files": {
      "type": "array",
      "items": { "$ref": "#/$defs/file_descriptor" }
    },
    "draft_checks": { "$ref": "#/$defs/draft_descriptor" }
  },
  "$defs": {
    "file_descriptor": {
      "type": "object",
      "required": ["path", "exists", "size_bytes", "is_dir"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "exists": { "type": "boolean" },
        "size_bytes": {
          "anyOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "is_dir": { "type": "boolean" }
      }
    },
    "draft_descriptor": {
      "type": "object",
      "required": ["path", "exists", "size_bytes", "head_lines"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "exists": { "type": "boolean" },
        "size_bytes": {
          "anyOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "head_lines": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
