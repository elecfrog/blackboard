{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bb://schema/spec-arena/peer-rating-output-v1",
  "title": "Spec Arena Peer Rating Output",
  "description": "Contract for one reviewer rating and sorting all four review outputs.",
  "type": "object",
  "required": [
    "peer_reviewer_id",
    "perspective",
    "sorted_reviews",
    "high_value_findings",
    "modification_advice",
    "conflicts_or_disagreements",
    "open_questions"
  ],
  "additionalProperties": false,
  "properties": {
    "peer_reviewer_id": { "type": "string", "minLength": 1 },
    "perspective": { "type": "string", "minLength": 1 },
    "sorted_reviews": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/scored_review" }
    },
    "high_value_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/high_value_finding" }
    },
    "modification_advice": {
      "type": "array",
      "items": {
        "anyOf": [
          { "type": "string", "minLength": 1 },
          { "$ref": "#/$defs/modification_advice" }
        ]
      }
    },
    "conflicts_or_disagreements": {
      "type": "array",
      "items": { "$ref": "#/$defs/conflict" }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "reviewer_id": { "type": "string", "minLength": 1 },
    "severity": {
      "type": "string",
      "enum": ["P0", "P1", "P2", "P3", "info"]
    },
    "score": { "type": "number", "minimum": 0 },
    "scored_review": {
      "type": "object",
      "required": ["reviewer_id", "rank", "stars", "rationale"],
      "additionalProperties": false,
      "properties": {
        "reviewer_id": { "$ref": "#/$defs/reviewer_id" },
        "rank": { "type": "integer", "minimum": 1 },
        "stars": { "$ref": "#/$defs/score" },
        "rationale": { "type": "string", "minLength": 1 },
        "evidence_strength": { "$ref": "#/$defs/score" },
        "novelty": { "$ref": "#/$defs/score" },
        "severity_calibration": { "$ref": "#/$defs/score" },
        "actionability": { "$ref": "#/$defs/score" },
        "false_positive_risk": { "$ref": "#/$defs/score" },
        "unique_contribution": { "type": "string" },
        "missed_items": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "possible_false_positives": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "high_value_finding": {
      "type": "object",
      "required": [
        "reviewer_id",
        "finding_id",
        "severity",
        "summary",
        "reason",
        "must_accept"
      ],
      "additionalProperties": false,
      "properties": {
        "reviewer_id": { "$ref": "#/$defs/reviewer_id" },
        "finding_id": { "type": "string", "minLength": 1 },
        "severity": { "$ref": "#/$defs/severity" },
        "summary": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "must_accept": { "type": "boolean" }
      }
    },
    "modification_advice": {
      "type": "object",
      "required": ["advice"],
      "properties": {
        "advice": { "type": "string", "minLength": 1 },
        "finding_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "priority": { "$ref": "#/$defs/severity" },
        "must_accept": { "type": "boolean" }
      }
    },
    "conflict": {
      "type": "object",
      "required": ["topic", "disagreement", "resolution"],
      "additionalProperties": false,
      "properties": {
        "topic": { "type": "string", "minLength": 1 },
        "disagreement": { "type": "string", "minLength": 1 },
        "resolution": { "type": "string", "minLength": 1 }
      }
    }
  }
}
