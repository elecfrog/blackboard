{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blackboard.local/schemas/resource-bundle.schema.json",
  "title": "Blackboard ResourceBundle",
  "description": "Structured resource envelope injected into enhanced LLM nodes. Domain-specific builders may add fields, but the envelope stays stable.",
  "type": "object",
  "required": [
    "schema_version",
    "resource_bundle_version",
    "kind",
    "builder",
    "task",
    "data_sources",
    "contracts"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "resource_bundle_version": {
      "type": "string",
      "const": "1.0"
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,127}$"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "builder": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "version",
        "script",
        "registry_version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]{2,127}$"
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,127}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "script": {
          "type": "string",
          "minLength": 1
        },
        "registry_version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "output_contract": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "task": {
      "type": "object"
    },
    "data_sources": {
      "type": "object"
    },
    "runtime": {
      "type": "object"
    },
    "contracts": {
      "type": "object"
    },
    "summary": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
