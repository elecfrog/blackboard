      "config": {
        "agent": "native",
        "inputs": {
          "resource_bundle": "{{nodes.resource-bundle.output}}",
          "original": "{{nodes.scout-plan-validate.output.data}}",
          "validation": "{{nodes.scout-plan-validate.output}}"
        },
        "model": "minimax-cn/MiniMax-M2.7-highspeed",
        "output": {
          "artifact_type": "json",
