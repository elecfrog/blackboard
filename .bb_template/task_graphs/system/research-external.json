        {
          "id": "resource_bundle",
          "label": "Resource Bundle",
          "direction": "in",
          "category": "data",
          "value_type": "json",
          "required": false
        },
        {
          "id": "exec_out",
          "label": "Out",
          "direction": "out",
          "category": "exec",
          "required": false
        },
        {
          "id": "output",
          "label": "Output",
          "direction": "out",
          "category": "data",
          "value_type": "json",
          "required": false
        }
      ]
    },
