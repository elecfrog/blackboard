        "research-output-contract"
      ],
      "description": "Skill ids expected by this graph; static node config also injects code-research for Pi."
    },
    {
      "id": "run-marker",
      "label": "Run Marker",
      "type": "string",
      "default": "research-internal",
      "description": "Output filename prefix under wiki/research and staging marker."
    },
    {
      "id": "output-slug",
