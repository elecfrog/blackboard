    {
      "id": "source-root",
      "label": "Source Root",
      "type": "string",
      "default": "{{env.workspace}}",
      "description": "Root directory for code or documents that scouts should investigate. Agent runtime cwd remains env.workspace."
    },
    {
      "id": "wiki-slice",
      "label": "Wiki Slice",
      "type": "string",
      "default": "",
      "description": "Optional wiki/context excerpt to include in the resource bundle."
    },
    {
      "id": "skills",
