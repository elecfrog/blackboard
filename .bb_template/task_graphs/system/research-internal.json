{
  "schema_version": 1,
  "id": "research-internal",
  "scope": "system",
  "title": "向内调研",
  "description": "通用内部代码调研系统管线：基于 ResourceBundle 输入契约和 Pi + MiniMax，面向当前工作区源码、文档、上游 artifacts 与 skills 动态规划 scouts，并由系统节点写入 wiki/research。",
  "version": 1,
  "readonly": false,
  "metadata": {
    "tags": [
      "system",
      "research",
      "internal",
      "code-search",
      "pi",
      "resource-bundle"
    ],
    "owner": "blackboard",
    "created_by": "codex",
    "updated_by": "codex",
    "run_policy": {
      "allow_concurrent_runs": true,
      "max_concurrent_runs": 3,
      "queue_enabled": true,
      "max_queue_wait_ms": 7200000,
      "queue_timeout_retry_enabled": true,
      "max_queue_timeout_retries": 5
    }
  },
  "inputs": [
    {
      "id": "input",
      "label": "Input Prompt",
      "type": "string",
      "default": "",
      "description": "User prompt for this task graph run."
