          "direction": "out",
          "category": "data",
          "value_type": "json",
          "required": false
        }
      ]
    },
    {
      "id": "system-write-report",
      "type": "system_write_output",
      "label": "System Write Internal Report",
      "description": "写入 runtime 内部报告；用户可见结论仍由最终 run output/人工验收决定。",
      "position": {
        "x": 2020.0,
        "y": 240.0
      },
      "config": {
        "artifact_type": "markdown",
        "content": "# Frontend UI Convergence Codex Report\n\n## Goal\n{{inputs.input}}\n\n## Codex Patch Report\n{{inputs.codex_report}}\n\n## Interactive UI Smoke\n{{inputs.smoke}}\n\n## Final Scan JSON\n```json\n{{inputs.scan}}\n```\n\n## Final Validation JSON\n```json\n{{inputs.validation}}\n```\n",
        "create_parent_dirs": true,
        "inputs": {
          "codex_report": "{{nodes.codex-patch.output}}",
          "scan": "{{nodes.scan-targets.output.stdout_json}}",
          "smoke": "{{nodes.interactive-smoke.output}}",
          "validation": "{{nodes.static-validate.output.stdout_json}}"
        },
        "output_path": "{{env.workspace}}/runtime/frontend-ui-convergence/{{inputs.output-slug}}.md",
        "overwrite": true
      },
      "pins": [
        {
          "id": "exec_in",
          "label": "In",
          "direction": "in",
          "category": "exec",
          "required": true
        },
        {
          "id": "content",
          "label": "Content",
          "direction": "in",
