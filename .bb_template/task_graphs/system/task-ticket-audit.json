{
  "schema_version": 1,
  "id": "task-ticket-audit",
  "scope": "system",
  "title": "Ticket Schema Audit / Repair（System Tool）",
  "description": "Ticket 日常巡检：脚本检查真实 JSON ticket；确定性 repair tool 只做安全 schema 归一化；复验通过才退出。",
  "version": 5,
  "readonly": true,
  "metadata": {
    "tags": [
      "system-tool",
      "ticket",
      "audit",
      "schema"
    ],
    "related_tickets": [
      "000075"
    ],
    "owner": "blackboard",
    "run_policy": {
      "allow_concurrent_runs": false,
      "max_concurrent_runs": 1,
      "queue_enabled": true,
      "max_queue_wait_ms": 1800000
    }
  },
  "inputs": [
    {
      "id": "max-iterations",
      "label": "最大修复轮数",
      "type": "number",
      "default": 3,
      "description": "每轮执行：脚本检查 -> LLM 修复 -> 脚本复验。",
      "min": 1.0,
      "max": 10.0
    }
  ],
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "label": "Start",
      "position": {
        "x": -32.0,
        "y": 120.0
      },
      "config": {},
      "pins": [
        {
          "id": "exec_out",
          "label": "Out",
          "direction": "out",
          "category": "exec",
          "required": false
        }
      ]
    },
    {
      "id": "ticket-audit-loop",
      "type": "loop",
      "label": "Ticket Audit Repair Loop",
      "description": "body_exit 的 shell checker 返回 exit_code=2 表示仍有 ticket findings，需要继续让 LLM 修复。",
      "position": {
        "x": 300.0,
        "y": 120.0
      },
      "config": {
        "body_entry": "ticket-audit-check",
        "body_exit": "ticket-audit-post-check",
        "condition": {
          "input_ref": "$.nodes.ticket-audit-post-check.output",
          "op": "equals",
          "path": "$.exit_code",
          "value": 2
        },
        "max_iterations": 3,
        "max_iterations_ref": "{{inputs.max-iterations}}",
        "on_max_iterations": "fail"
      },
      "pins": [
        {
          "id": "exec_in",
          "label": "In",
          "direction": "in",
          "category": "exec",
          "required": true
        },
        {
          "id": "body",
          "label": "Body",
          "direction": "out",
          "category": "exec",
          "required": false
        },
        {
          "id": "exit",
          "label": "Exit",
          "direction": "out",
          "category": "exec",
          "required": false
        },
        {
          "id": "index",
          "label": "Index",
          "direction": "out",
          "category": "data",
          "value_type": "int",
          "required": false
        }
      ]
    },
    {
      "id": "ticket-audit-check",
      "type": "shell",
      "label": "Ticket Schema Check",
      "description": "读取 .bb_template/schemas/ticket.schema.json，对真实 ticket 文件做 schema/business/script 级检查。",
      "position": {
        "x": 640.0,
        "y": 40.0
      },
      "config": {
        "args": [
          "{{env.scripts_dir}}/audit_tickets.py",
          "--project",
          "{{env.project}}",
          "--repo-root",
          "{{env.root}}/..",
          "--run-schema-check",
          "--run-maintenance"
        ],
        "capture": {
          "max_bytes": 65536,
          "strip_ansi": true
        },
        "command": "python3",
        "expected_exit_codes": [
          0,
          2
        ],
        "permission": "project_write",
        "timeout_ms": 300000
      },
      "pins": [
        {
          "id": "exec_in",
          "label": "In",
          "direction": "in",
          "category": "exec",
          "required": true
        },
        {
          "id": "exec_out",
          "label": "Out",
          "direction": "out",
          "category": "exec",
          "required": false
        },
        {
          "id": "output",
          "label": "Output",
          "direction": "out",
          "category": "data",
          "value_type": "json",
          "required": false
        }
      ]
    },
    {
      "id": "ticket-audit-route",
      "type": "branch",
      "label": "Audit Route",
      "position": {
        "x": 960.0,
        "y": 40.0
      },
      "config": {
        "default_rule_id": "clean",
        "input_ref": "$.nodes.ticket-audit-check.output",
        "mode": "condition",
        "rules": [
          {
            "id": "clean",
            "label": "Clean",
            "when": {
              "op": "equals",
              "path": "$.exit_code",
              "value": 0
            }
          },
          {
            "id": "dirty",
            "label": "Dirty",
            "when": {
              "op": "equals",
              "path": "$.exit_code",
              "value": 2
            }
          }
        ]
      },
      "pins": [
        {
          "id": "exec_in",
          "label": "In",
          "direction": "in",
          "category": "exec",
          "required": true
        },
        {
          "id": "rule:clean",
          "label": "Clean",
          "direction": "out",
          "category": "exec",
          "required": false
        },
        {
          "id": "rule:dirty",
          "label": "Dirty",
          "direction": "out",
          "category": "exec",
          "required": false
        }
      ]
    },
    {
      "id": "ticket-audit-repair",
      "type": "shell",
      "label": "Ticket Safe Repair Tool",
      "description": "确定性工具：根据 audit report 对报告列出的 JSON ticket 做安全 schema 归一化，不处理 inbox/lane/新建 ticket。",
      "position": {
        "x": 1280.0,
        "y": 154.0
      },
      "config": {
        "command": "python3",
        "args": [
          "{{env.scripts_dir}}/repair_tickets_from_audit.py",
          "--project",
          "{{env.project}}",
          "--repo-root",
          "{{env.root}}/..",
          "--report-path",
          "{{env.root}}/runtime/ticket-audit/{{env.project}}-latest.json"
        ],
        "capture": {
          "max_bytes": 65536,
          "strip_ansi": true
        },
        "expected_exit_codes": [
          0
        ],
        "permission": "project_write",
        "timeout_ms": 300000
      },
      "pins": [
        {
          "id": "exec_in",
          "label": "In",
          "direction": "in",
          "category": "exec",
          "required": true
        },
        {
          "id": "exec_out",
          "label": "Out",
          "direction": "out",
          "category": "exec",
          "required": false
        },
        {
          "id": "output",
          "label": "Output",
          "direction": "out",
          "category": "data",
          "value_type": "json",
          "required": false
        }
      ]
    },
    {
      "id": "ticket-repair-output-validate",
      "type": "schema_validate",
      "label": "Repair Output Validate",
      "description": "系统 repair tool 输出 contract gate；真实 ticket 正确性仍由后续 shell checker 决定。",
      "position": {
        "x": 1600.0,
        "y": 154.0
      },
      "config": {
        "fail_on_invalid": true,
        "inputs": {
          "value": "{{nodes.ticket-audit-repair.output.stdout_json}}"
        },
        "schema": {
          "additionalProperties": false,
          "properties": {
            "changed": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "fields": {
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "id": {
                    "pattern": "^[0-9]{6}$",
                    "type": "string"
                  },
                  "reason": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "fields",
                  "reason"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "skipped": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "pattern": "^[0-9]{6}$",
                    "type": "string"
                  },
                  "reason": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "reason"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "summary": {
              "minLength": 1,
              "type": "string"
            },
            "ticket_validation": {
              "additionalProperties": false,
              "properties": {
                "audit_status_before": {
                  "enum": [
                    "passed",
                    "failed"
                  ],
                  "type": "string"
                },
                "finding_count_before": {
                  "minimum": 0,
                  "type": "integer"
                },
                "report_path": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "audit_status_before",
                "finding_count_before",
                "report_path"
              ],
              "type": "object"
            },
            "verification": {
              "additionalProperties": false,
              "properties": {
                "audit_report_consumed": {
                  "enum": [
                    "passed",
                    "failed"
                  ],
                  "type": "string"
                },
                "repair_attempted": {
                  "enum": [
                    "passed",
                    "failed",
                    "not_needed"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "audit_report_consumed",
                "repair_attempted"
              ],
              "type": "object"
            }
          },
          "required": [
            "summary",
            "changed",
            "skipped",
            "ticket_validation",
            "verification"
          ],
          "type": "object"
        },
        "schema_name": "ticket_audit_repair_output"
      },
      "pins": [
        {
          "id": "exec_in",
          "label": "In",
          "direction": "in",
          "category": "exec",
          "required": true
        },
        {
          "id": "exec_out",
          "label": "Out",
          "direction": "out",
          "category": "exec",
          "required": false
        },
        {
          "id": "output",
          "label": "Output",
          "direction": "out",
          "category": "data",
          "value_type": "json",
          "required": false
        }
      ]
    },
    {
      "id": "ticket-audit-post-check",
      "type": "shell",
      "label": "Post Repair Check",
      "description": "LLM 修复后复验；exit_code=0 才允许 loop 退出。",
      "position": {
        "x": 1906.2563955584349,
        "y": 40.0
      },
      "config": {
        "args": [
          "{{env.scripts_dir}}/audit_tickets.py",
          "--project",
          "{{env.project}}",
          "--repo-root",
          "{{env.root}}/..",
          "--run-schema-check",
          "--run-maintenance"
        ],
        "capture": {
          "max_bytes": 65536,
          "strip_ansi": true
        },
        "command": "python3",
        "expected_exit_codes": [
          0,
          2
        ],
        "permission": "project_write",
        "timeout_ms": 300000
      },
      "pins": [
        {
          "id": "exec_in",
          "label": "In",
          "direction": "in",
          "category": "exec",
          "required": true
        },
        {
          "id": "exec_out",
          "label": "Out",
          "direction": "out",
          "category": "exec",
          "required": false
        },
        {
          "id": "output",
          "label": "Output",
          "direction": "out",
          "category": "data",
          "value_type": "json",
          "required": false
        }
      ]
    },
    {
      "id": "end-success",
      "type": "end",
      "label": "Success",
      "position": {
        "x": 643.2152821895769,
        "y": 212.76344092462648
      },
      "config": {
        "result": "succeeded"
      },
      "pins": [
        {
          "id": "exec_in",
          "label": "In",
          "direction": "in",
          "category": "exec",
          "required": true
        }
      ]
    }
  ],
  "edges": [
    {
      "id": "edge-start-loop",
      "from": "start",
      "to": "ticket-audit-loop",
      "kind": "exec",
      "from_pin": "exec_out",
      "to_pin": "exec_in"
    },
    {
      "id": "edge-loop-check",
      "from": "ticket-audit-loop",
      "to": "ticket-audit-check",
      "kind": "exec",
      "from_pin": "body",
      "to_pin": "exec_in"
    },
    {
      "id": "edge-check-route",
      "from": "ticket-audit-check",
      "to": "ticket-audit-route",
      "kind": "exec",
      "from_pin": "exec_out",
      "to_pin": "exec_in"
    },
    {
      "id": "edge-clean-post-check",
      "from": "ticket-audit-route",
      "to": "ticket-audit-post-check",
      "kind": "exec",
      "from_pin": "rule:clean",
      "to_pin": "exec_in",
      "source_handle": "rule:clean"
    },
    {
      "id": "edge-dirty-repair",
      "from": "ticket-audit-route",
      "to": "ticket-audit-repair",
      "kind": "exec",
      "from_pin": "rule:dirty",
      "to_pin": "exec_in",
      "source_handle": "rule:dirty"
    },
    {
      "id": "edge-repair-validate",
      "from": "ticket-audit-repair",
      "to": "ticket-repair-output-validate",
      "kind": "exec",
      "from_pin": "exec_out",
      "to_pin": "exec_in"
    },
    {
      "id": "edge-repair-validate-post-check",
      "from": "ticket-repair-output-validate",
      "to": "ticket-audit-post-check",
      "kind": "exec",
      "from_pin": "exec_out",
      "to_pin": "exec_in"
    },
    {
      "id": "edge-loop-exit-end",
      "from": "ticket-audit-loop",
      "to": "end-success",
      "kind": "exec",
      "from_pin": "exit",
      "to_pin": "exec_in"
    }
  ]
}
