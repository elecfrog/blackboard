{
  "schema_version": 1,
  "id": "code-monitor-check-fix",
  "scope": "system",
  "title": "代码监控检查和修复",
  "description": "内联系统管线：前端 i18n、前端明暗模式、Rust Clippy/Fmt 检查修复并发运行；前端与后端各自通过确定性工具编译验证闭环重试；前端并发 Agent 先经过写入边界审计，再汇总并通过 Pi MCP adapter 写入 Blackboard handoff。",
  "version": 13,
  "readonly": false,
  "metadata": {
    "tags": [
      "system",
      "code-health",
      "frontend",
      "i18n",
      "theme",
      "rust",
      "clippy",
      "pi",
      "mcp",
      "handoff",
      "write-scope-audit",
      "concurrency-hardening",
      "isolated-cargo-target",
      "rustfmt",
      "deterministic-format"
    ],
    "owner": "blackboard",
    "created_by": "codex",
    "updated_by": "codex"
  },
  "inputs": [
    {
      "id": "project",
      "label": "项目名",
      "type": "string",
      "default": "blackboard"
    },
    {
      "id": "frontend-workspace",
      "label": "前端工作区路径",
      "type": "string",
      "default": "bb_web",
      "description": "前端项目路径，如 bb_web"
    },
    {
      "id": "workspace",
      "label": "Rust 工作区路径",
      "type": "string",
      "default": "bb_backend",
      "description": "Rust 项目路径，如 bb_backend 或 bb_desktop/src-tauri"
    },
    {
      "id": "package",
      "label": "Rust 包名（可选）",
      "type": "string",
      "default": "",
      "description": "指定包名，如 bb_cli。空则检查所有包"
    },
    {
      "id": "max-iterations",
      "label": "最大修复轮次",
      "type": "number",
      "default": 5,
      "description": "每个闭环最多重试多少轮",
      "min": 1.0,
      "max": 20.0
    }
