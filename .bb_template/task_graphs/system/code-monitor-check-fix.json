        "runtime": "pi",
        "tool_policy": {
          "allowed_tools": [
            "bash",
            "read",
            "grep",
            "find",
            "ls"
          ],
          "bash": {
            "blacklist": [
              "*cargo clean*",
              "*git checkout*",
              "*git switch*",
              "*git reset*",
              "*git clean*",
              "*git restore*",
              "*git revert*",
              "*rm -rf*",
              "*Remove-Item* -Recurse*",
              "*rd /s*",
              "*rmdir /s*",
              "*del /s*"
            ],
            "whitelist": [
              "*cargo clippy*",
              "*cargo check*",
              "*cargo fmt*",
              "echo",
              "echo *",
              "ls",
              "ls *",
              "pwd"
            ]
          }
        }
      },
