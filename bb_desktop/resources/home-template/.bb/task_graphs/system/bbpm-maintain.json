      "default": 20,
      "min": 1.0,
      "description": "每轮最多清理 20 条 JSON inbox note。",
      "max": 20.0
    },
    {
      "id": "inbox-max-iterations",
      "label": "最大循环次数",
      "type": "number",
      "default": 20,
      "min": 1.0,
      "description": "最多 20 轮，理论上最多处理 400 条 JSON inbox note。",
      "max": 20.0
    },
    {
