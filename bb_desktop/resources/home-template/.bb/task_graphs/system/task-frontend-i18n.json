{
  "schema_version": 1,
  "id": "task-frontend-i18n",
  "scope": "system",
  "title": "前端 i18n 检查修复",
  "description": "单节点子流水线：包装 frontend-i18n task 为可被父流水线调用的子流水线。",
  "version": 1,
  "readonly": true,
  "metadata": {
    "tags": [
      "task-wrapper",
      "frontend",
      "smoke"
    ],
    "owner": "blackboard"
  },
  "inputs": [
    {
      "id": "project",
      "label": "项目名",
      "type": "string",
      "default": "blackboard"
    }
  ],
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "label": "Start",
      "position": {
        "x": 40,
        "y": 120
      },
      "config": {},
      "pins": [
        {
          "id": "exec_out",
          "label": "Out",
          "direction": "out",
          "category": "exec",
          "required": false
        }
      ]
    },
    {
      "id": "llm-exec",
      "type": "llm",
      "label": "前端 i18n 检查修复",
      "position": {
        "x": 320,
        "y": 120
      },
      "config": {
        "runtime": "opencode",
        "agent": "native",
        "model": null,
        "prompt": {
          "mode": "file",
          "template": "agents/prompts/frontend-i18n.md"
        },
        "output": {
          "artifact_type": "json",
          "required": true
        }
      },
      "pins": [
        {
          "id": "exec_in",
          "label": "In",
          "direction": "in",
          "category": "exec",
          "required": true
        },
        {
          "id": "exec_out",
          "label": "Out",
          "direction": "out",
          "category": "exec",
          "required": false
        },
        {
          "id": "output",
          "label": "Output",
          "direction": "out",
          "category": "data",
          "value_type": "json",
          "required": false
        }
      ]
    },
    {
      "id": "end-success",
      "type": "end",
      "label": "Success",
      "position": {
        "x": 620,
        "y": 120
      },
      "config": {
        "result": "succeeded"
      },
      "pins": [
        {
          "id": "exec_in",
          "label": "In",
          "direction": "in",
          "category": "exec",
          "required": true
        }
      ]
    }
  ],
  "edges": [
    {
      "id": "edge-start-llm",
      "from": "start",
      "to": "llm-exec",
      "kind": "exec",
      "from_pin": "exec_out",
      "to_pin": "exec_in"
    },
    {
      "id": "edge-llm-end",
      "from": "llm-exec",
      "to": "end-success",
      "kind": "exec",
      "from_pin": "exec_out",
      "to_pin": "exec_in"
    }
  ]
}