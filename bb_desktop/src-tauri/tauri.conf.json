{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Blackboard",
  "version": "0.1.0",
  "identifier": "com.blackboard.desktop",
  "build": {
    "beforeDevCommand": "python ../scripts/desktop.py prepare --dev",
    "beforeBuildCommand": "python ../scripts/desktop.py prepare --release",
    "frontendDist": "../resources/web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/bb",
      "binaries/bb-daemon"
    ],
    "resources": {
      "../resources/web/": "web",
      "../resources/seed/": "seed",
      "../resources/home-template/": "home-template"
    },
    "icon": [
      "icons/icon.ico"
    ]
  }
}
